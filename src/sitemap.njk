---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{#- Empty while the site is a preview or has no address: nothing is announced to search engines yet. #}
{%- if site.url and not site.preview %}
{%- for entry in collections.all %}
{%- if entry.url and entry.url != "/404.html" and entry.url.endsWith("/") %}
  <url>
    <loc>{{ site.url }}{{ entry.url }}</loc>
    <lastmod>{{ entry.date | isoDate }}</lastmod>
  </url>
{%- endif %}
{%- endfor %}
{%- endif %}
</urlset>
