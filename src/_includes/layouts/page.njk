---
layout: layouts/base.njk
---
<header class="page-head">
  <div class="wrap">
    <p class="eyebrow rise">{{ eyebrow }}</p>
    <h1 class="page-head__title rise" style="--rise-delay: 1">{{ title }}</h1>
    {%- if lede %}
    <p class="page-head__lede rise" style="--rise-delay: 2">{{ lede }}</p>
    {%- endif %}
  </div>
</header>
{{ content | safe }}
