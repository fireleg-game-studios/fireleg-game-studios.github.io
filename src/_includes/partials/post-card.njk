{#- A small article card. Expects `post`. -#}
<article class="post-card" data-reveal style="--cover-position: {{ post.data.cover.position or 'center' }}">
  <div class="post-card__media" aria-hidden="true">
    {% image post.data.cover.src, "", { widths: [480, 800], sizes: "(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 26rem" } %}
  </div>
  <div class="post-card__body">
    <span class="tag">{{ post.data.category }}</span>
    <h2 class="post-card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  </div>
</article>
