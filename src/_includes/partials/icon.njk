  <circle cx="20" cy="20" r="15"/><path d="M26 14 22.5 22.5 14 26l3.5-8.5Z"/><circle cx="20" cy="20" r="1"/><path d="M20 5v3M20 32v3M5 20h3M32 20h3"/>
