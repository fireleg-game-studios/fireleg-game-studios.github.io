  <circle cx="14" cy="14" r="7"/><circle cx="14" cy="14" r="2.5"/><path d="M19 19 34 34M28 28l4-4M32 32l3-3"/>
  {%- elif iconName == "magnifier" %}
  <circle cx="17" cy="17" r="10"/><path d="M24.5 24.5 35 35M11 17a6 6 0 0 1 6-6"/>
  {%- elif iconName == "flame" %}
  <path d="M20 4c1 6 9 10 9 19a9 9 0 0 1-18 0c0-4 2-6 3-9 1 2 2 3 3 3 1-4 1-9 3-13Z"/><path d="M20 21c1 3 4 4 4 7a4 4 0 0 1-8 0c0-3 3-4 4-7Z"/>
