{#- Line icons drawn for this site. Expects `iconName`. -#}
<svg class="icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
