<a class="brand" href="/" aria-label="{{ site.name }}, home">
  <span class="brand__mark">{% image "brand/emblem.webp", "", { widths: [56, 112], formats: ["webp"], sizes: "44px", eager: true } %}</span>
  <span class="brand__text" aria-hidden="true">
    <span class="brand__name">{{ site.shortName }}</span>
    <span class="brand__sub">{{ site.subName }}</span>
  </span>
</a>
